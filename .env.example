# Copy this file to .env and fill in values.
# Never commit .env (it is ignored by .gitignore).
#
# Note: IssueForge does not automatically load .env.
# Use your shell to export these variables before running scripts.

# -------------------------
# Jira (Atlassian Cloud)
# -------------------------
# Example: https://your-domain.atlassian.net
JIRA_BASE_URL=

# The Atlassian account email used for Jira
JIRA_EMAIL=

# Jira API token (not your password)
JIRA_API_TOKEN=
